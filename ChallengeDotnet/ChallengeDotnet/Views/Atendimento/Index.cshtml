@model IEnumerable<Atendimento>

@{
    ViewData["Title"] = "Index";
}

<h1>Atendimentos</h1>

<p>
    <a asp-action="Create">Criar novo atendimento</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AtendimentoId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DentistaNome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClinicaNome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataAtendimento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DescricaoProcedimento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Custo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataRegistro)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.AtendimentoId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UsuarioId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DentistaNome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ClinicaNome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataAtendimento)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DescricaoProcedimento)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Custo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataRegistro)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AtendimentoId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.AtendimentoId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>